# 后端环境变量模板：复制为 .env 后填入真实值
#   cp .env.example .env
# 敏感信息（.env / .env.production）已加入 .gitignore，请勿提交。

# 数据库连接
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=real_time

# JWT 签名密钥（必填，请使用强随机值，至少 32 字符）
# 生成命令：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please_generate_a_strong_random_secret
JWT_EXPIRES_IN=7d
PORT=3001

# 可选：Redis（多实例/多副本部署需配置；驱动 Redis 共享缓存、跨实例请求聚合与 BullMQ 任务队列分发）
#   redis://[user:pass@]host:port/db  （如 redis://localhost:6379/0，需 Redis 6.2+）
#   若 Redis 开启了密码认证：redis://:yourpassword@host:6379/0  （user 留空时的写法）
# REDIS_URL=redis://:yourpassword@host:6379/0
# 未配置时回退为单进程模式：内存+文件缓存、定时任务（定投/日收益/pending 结算）进程内直接执行，行为与旧版一致。

# 可选：全局外部拉取并发护栏（各 Node 实例生效，总在途 = 实例数 × 该值）。默认 20。
# 用于限制单个实例同时进行的外部数据请求数（东方财富/新浪/腾讯等），配合跨实例单飞防止雪崩。
# EXTERNAL_FETCH_CONCURRENCY=20

# 可选：跨域来源（逗号分隔，如 https://example.com）
CORS_ORIGIN=

# 可选：百度 OCR（图片识别导入需要，未配置时该功能不可用）
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=